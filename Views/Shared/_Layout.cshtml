<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Botrix</title>
    <!-- Bootstrap 5 desde CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

</head>
<body>
    <div class="container">
        <header>
            <h1>Botrix - Panel Administrativo</h1>
            <nav>
                <!-- Enlaces correctos para MVC -->
                <a asp-controller="Admin" asp-action="Index">Respuestas</a> |
                <a asp-controller="Admin" asp-action="Stats">Estadísticas</a> |
                <a asp-controller="Police" asp-action="Index">Políticas</a>
            </nav>
        </header>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
        <footer>
            <p>&copy; 2026 - Botrix</p>
        </footer>
    </div>



    <!-- Bootstrap JS desde CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYzW+f2Q+bR+6YB1hFjz4lW2zF2QpztNJq0pPjzv9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
</body>
</html>
